# Copy this file to .env and enter your local settings.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=marketing_lab
DB_USER=YOUR_LOCAL_MYSQL_USER
DB_PASSWORD="YOUR_LOCAL_MYSQL_PASSWORD"

# Configure credentials separately with: aws configure --profile marketing-lab
AWS_PROFILE=marketing-lab
AWS_REGION="YOUR_QUEUE_REGION"
SQS_QUEUE_URL="YOUR_MAIN_QUEUE_URL"

MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USERNAME="YOUR_SANDBOX_USERNAME"
MAILTRAP_PASSWORD="YOUR_SANDBOX_PASSWORD"
MAIL_FROM_ADDRESS=marketing@example.com
MAILTRAP_DELAY_SECONDS=11
